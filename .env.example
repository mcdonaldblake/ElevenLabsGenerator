# Plain ElevenLabs text-to-speech is the only external generation service.
# Phrase writing, rewriting, categorization, and review are always human-led.
ELEVENLABS_API_KEY=
TTS_PROVIDER=mock

LOCAL_SERVER_PORT=4317
# Leave disabled for normal Mac-only use. `pnpm start:iphone` enables this
# for that run and prints a private-network URL plus a per-run pairing code.
LAN_ACCESS_ENABLED=false
DATABASE_PATH=./data/voice-foundry.sqlite
AUDIO_ROOT=./data/generated-audio
EXPORT_ROOT=./data/exports

ELEVENLABS_DEFAULT_CONCURRENCY=2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
MAX_CLIPS_PER_BATCH=2000
MAX_CHARACTERS_PER_BATCH=250000
OPEN_BROWSER=false
