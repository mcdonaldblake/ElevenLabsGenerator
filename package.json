{
  "name": "frase-uno-voice-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors yellow,cyan \"pnpm --filter @voice-foundry/server dev\" \"pnpm --filter @voice-foundry/web dev\"",
    "build": "pnpm --filter @voice-foundry/web build && pnpm --filter @voice-foundry/server build",
    "start": "pnpm build && pnpm --filter @voice-foundry/server start",
    "start:iphone": "LAN_ACCESS_ENABLED=true pnpm start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "sample:large": "node scripts/generate-large-sample.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "concurrently": "latest",
    "drizzle-kit": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
